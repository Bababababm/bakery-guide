rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /products/{productId}/{stage}/{filename} {
   allow read: if request.auth != null;
   allow write: if request.auth != null && request.resource.size < 12 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); // TEST ONLY
  }
 }
}
